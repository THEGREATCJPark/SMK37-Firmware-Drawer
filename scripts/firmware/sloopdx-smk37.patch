diff --git a/tests/sloopdx_smk_failure_test.c b/tests/sloopdx_smk_failure_test.c
new file mode 100644
index 0000000..7074a5d
--- /dev/null
+++ b/tests/sloopdx_smk_failure_test.c
@@ -0,0 +1,83 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* Failure injection for the SMK initialization boundary. In-memory NOR only. */
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <assert.h>
+#include "fm1_flash_map.h"
+static uint8_t nor[0x100000];
+static uint32_t mutations, fault_off, hits, fail_hit;
+static char fault_op;
+static int silent;
+static int st_stock_touch(uint32_t off);
+static int fault(char op,uint32_t off) { return op==fault_op && off==fault_off && ++hits==fail_hit; }
+static int st_read(uint32_t off,void *dst,uint32_t n) {
+ if(fault('r',off)) return -1;
+ memcpy(dst,nor+off,n);return 0;
+}
+static int st_erase(uint32_t off) {
+ assert(FL_STORE_OK(off,4096)||FL_STOCKTAG_OK(off,4096));
+ if(st_stock_touch(off))return -8;
+ if(fault('e',off))return silent?0:-1;
+ memset(nor+off,255,4096);mutations++;return 0;
+}
+static int st_prog(uint32_t off,const void *src,uint32_t n) {
+ assert(FL_STORE_OK(off,n));
+ if(fault('p',off))return silent?0:-1;
+ for(uint32_t i=0;i<n;i++)nor[off+i]&=((const uint8_t*)src)[i];
+ mutations++;return 0;
+}
+static uint32_t init_ticks;
+#define ST_INIT_TICK() (init_ticks++)
+#define ST_XIP_PTR(off) (nor+(off))
+#include "../firmware/src/storage.c"
+static void inject(char op,uint32_t off,uint32_t nth,int no_op) {
+ fault_op=op;fault_off=off;fail_hit=nth;hits=0;silent=no_op;
+}
+static void clear_fault(void) { fault_op=0; }
+static void foreign(void) {
+ clear_fault();memset(nor,255,sizeof nor);assert(st_storage_init()==0);
+ for(uint32_t o=0;o<OBJ_COUNT;o++){uint32_t v=o+42;assert(st_save(o,&v,4)==0);}
+ memcpy(nor+ST_OWNER_OFF,"SMK37DATASLOOP\0\0",16);
+ st_owner_ready=0;mutations=0;
+}
+static void denied(void) {
+ uint32_t v=123,n=mutations,len=0;
+ assert(!st_owner_ready);assert(st_load(OBJ_SETTINGS,&v,4)<0);
+ assert(st_xip(OBJ_SETTINGS,&len)==0);
+ assert(st_save(OBJ_SETTINGS,&v,4)<0);assert(st_wipe_all()<0);assert(mutations==n);
+}
+static void owner_case(char op,uint32_t off,uint32_t nth,int no_op) {
+ foreign();inject(op,off,nth,no_op);
+ assert(st_storage_init()<0);denied();
+ if (off != ST_OWNER_OFF) assert(memcmp(nor+ST_OWNER_OFF,"SMK37DATASLOOPDX",16));
+ /* The failure cannot prevent the next boot from retrying. */
+ clear_fault();assert(st_storage_init()==0);assert(st_owner_ready);
+ for(uint32_t o=0;o<OBJ_COUNT;o++){uint32_t v;assert(st_load(o,&v,4)<0);}
+}
+int main(void) {
+ clear_fault();memset(nor,255,sizeof nor);init_ticks=0;assert(st_storage_init()==0);assert(init_ticks==OBJ_COUNT*2u+1u);
+ /* Marker protection: no USRFLASH mutation on read, erase, readback or silent erase failure. */
+ for(int kind=0;kind<4;kind++) {
+  clear_fault();memset(nor,255,sizeof nor);memcpy(nor+FL_STOCKTAG_OFF,"usrdata",8);
+  memset(nor+FL_SMP_LO,0x5a,4096);
+  inject(kind==0||kind==3?'r':'e',kind==0||kind==3?FL_STOCKTAG_OFF:FL_STOCKTAG_LO,kind==3?2:1,kind==2);
+  assert(st_erase(FL_SMP_LO)<0);
+  for(uint32_t i=0;i<4096;i++)assert(nor[FL_SMP_LO+i]==0x5a);
+  clear_fault();assert(st_erase(FL_SMP_LO)==0);assert(st_stock_tagged()==0);
+ }
+ /* Boot must not skip an unreadable stock marker. */
+ foreign();inject('r',FL_STOCKTAG_OFF,1,0);assert(st_storage_init()<0);denied();
+ owner_case('r',ST_OWNER_OFF,1,0);                    /* initial owner read */
+ owner_case('e',st_sector(0,0),1,0);                /* first object erase */
+ owner_case('e',st_sector(OBJ_COUNT-1,1),1,0);      /* final object erase */
+ owner_case('e',st_sector(0,0),1,1);                /* silent no-op leaves valid foreign CRC */
+ owner_case('r',st_sector(0,0),1,0);                /* object erase readback */
+ owner_case('e',ST_OWNER_OFF,1,0);                  /* owner erase */
+ owner_case('e',ST_OWNER_OFF,1,1);                  /* silent owner erase */
+ owner_case('p',ST_OWNER_OFF,1,0);                  /* owner commit program */
+ owner_case('p',ST_OWNER_OFF,1,1);                  /* silent owner program */
+ owner_case('r',ST_OWNER_OFF,3,0);                  /* tag read, erase check, commit readback */
+ puts("sloopDX SMK failure injection: marker errors block USRFLASH; owner errors block reads/writes and retry PASS");
+ return 0;
+}
diff --git a/tests/sloopdx_smk_storage_test.c b/tests/sloopdx_smk_storage_test.c
new file mode 100644
index 0000000..9b2af0a
