+++ b/tests/sloopdx_smk_storage_test.c
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* sloopDX SMK persistent-object regression: fake NOR only, no device access. */
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <assert.h>
+#include "fm1_flash_map.h"
+static uint8_t nor[0x100000];
+static uint32_t erases;
+static int st_read(uint32_t off, void *dst, uint32_t n) { assert(off+n<=sizeof nor); memcpy(dst,nor+off,n);return 0; }
+static int st_erase(uint32_t off) { assert(FL_STORE_OK(off,4096)||FL_STOCKTAG_OK(off,4096));memset(nor+off,255,4096);erases++;return 0; }
+static int st_prog(uint32_t off,const void *src,uint32_t n) { assert(FL_STORE_OK(off,n));for(uint32_t i=0;i<n;i++)nor[off+i]&=((const uint8_t*)src)[i];return 0; }
+#include "../firmware/src/storage.c"
+int main(void) {
+ memset(nor,255,sizeof nor);
+ memset(nor+0xC0000,0x5a,0x2000);memset(nor+0xF4000,0x5a,0xA000);memset(nor+0xFF000,0x5a,0x1000);
+ st_owner_check();assert(erases==53);assert(!memcmp(nor+0xAF000,"SMK37DATASLOOPDX",16));
+ uint32_t n=erases;st_owner_check();assert(erases==n);
+ for(uint32_t o=0;o<OBJ_COUNT;o++) {
+  uint32_t a=0xa000+o,b=0xb000+o,x=0;
+  assert(st_save(o,&a,4)==0);assert(st_load(o,&x,4)==4&&x==a);
+  assert(st_save(o,&b,4)==0);assert(st_load(o,&x,4)==4&&x==b);
+  st_hdr_t h;int c=st_current(o,&h);assert(c>=0);
+  nor[st_sector(o,(uint32_t)c)+ST_PAYLOAD_OFF]^=1;
+  assert(st_load(o,&x,4)==4&&x==a);
+ }
+ for(uint32_t i=0xC0000;i<0xC2000;i++)assert(nor[i]==0x5a);
+ for(uint32_t i=0xF4000;i<0xFE000;i++)assert(nor[i]==0x5a);
+ for(uint32_t i=0xFF000;i<0x100000;i++)assert(nor[i]==0x5a);
+ memcpy(nor+ST_OWNER_OFF,"SMK37DATASLOOP\0\0",16);st_owner_check();
+ for(uint32_t o=0;o<OBJ_COUNT;o++){uint32_t x;assert(st_load(o,&x,4)==-1);}
+ puts("sloopDX SMK: all 26 objects A/B, corrupted-copy fallback, family switching, protected sentinels PASS");return 0;
+}
diff --git a/tests/smk_flash_test.c b/tests/smk_flash_test.c
new file mode 100644
index 0000000..a13f2ba
--- /dev/null
+++ b/tests/smk_flash_test.c
@@ -0,0 +1,79 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* SMK-37 Pro flash map (build with -DBOARD_SMK37=1; see the fm1-to-smk37 guide):
+ * every 4 KiB sector of the 1 MiB part through the app's allow-list (FL_RANGE_OK / FL_GUARD, fm1_flash.h),
+ * the update loader's (loader.c) and ldr_core.c's record window: none of them may ever reach
+ * the head 0x0-0x3FFF, BTIF / USRTRIM 0xC0000-0xC1FFF, USR 0xF4000-0xFDFFF or key_mac 0xFF000-;
+ * the store's objects (storage.c), the user sample slots (eng_sample.c) and the OTA staging (ota.c) lie
+ * inside the allowed windows; ranges that wrap or straddle a boundary are refused. */
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "fm1_cc.h"
+#if !BOARD_SMK37
+#error "build with -DBOARD_SMK37=1"
+#endif
+
+#include "fm1_flash_map.h"
+
+static int st_read(uint32_t off, void *dst, uint32_t n) { (void)off; (void)dst; (void)n; return -1; }
+static int st_erase(uint32_t off) { (void)off; return -1; }
+static int st_prog(uint32_t off, const void *src, uint32_t n) { (void)off; (void)src; (void)n; return -1; }
+#include "../firmware/src/storage.c"
+#define LDR_RANGE_OK(off, n) FL_LDR_RANGE_OK(off, n)       /* what loader.c uses on the SMK */
+
+static int bad;
+static void check(const char *what, int ok) { printf("smk flash: %-78s %s\n", what, ok ? "ok" : "FAIL"); bad += !ok; }
+
+static int protected_sector(uint32_t s)
+{
+    return s < 0x4000u || (s >= 0xC0000u && s < 0xC2000u) || (s >= 0xF4000u && s < 0xFE000u) || s >= 0xFF000u;
+}
+
+int main(void)
+{
+    uint32_t s, o, c, leak_app = 0, leak_ldr = 0, leak_guard = 0, allowed = 0, in_store = 1;
+    for (s = 0; s < 0x100000u; s += 0x1000u) {
+        if (!protected_sector(s))
+            continue;
+        leak_app += FL_RANGE_OK(s, 0x1000u) || FL_STORE_OK(s, 0x1000u) || FL_RANGE_OK(s, 256u) || FL_RANGE_OK(s + 0xF00u, 256u);
+        leak_ldr += LDR_RANGE_OK(s, 0x1000u) || LDR_RANGE_OK(s + 0xF00u, 256u);
+        leak_guard += !FL_PROTECTED(s, 0x1000u) || !FL_PROTECTED(s + 0xF00u, 256u);
+    }
+    for (s = 0; s < 0x100000u; s += 0x1000u)
+        allowed += FL_GUARD(s, 0x1000u);
+    check("no protected sector passes the app's allow-list (erase, page)", leak_app == 0);
+    check("no protected sector passes the loader's allow-list", leak_ldr == 0);
+    check("the RAM driver's own net (FL_PROTECTED) covers every protected sector", leak_guard == 0);
+    check("straddling ranges refused: 0xBF000+0x2000, 0xE9000+0x2000, 0x3000+0x2000",
+          !FL_GUARD(0xBF000u, 0x2000u) && !FL_GUARD(0xE9000u, 0x2000u) && !LDR_RANGE_OK(0xBF000u, 0x2000u) &&
+          !LDR_RANGE_OK(0x3000u, 0x2000u) && FL_PROTECTED(0xBF000u, 0x2000u) && FL_PROTECTED(0x3F00u, 0x200u));
+    check("wrapping ranges refused (off + n past 4 GiB)",
+          !FL_GUARD(0xBB000u, 0xFFFFF000u) && !LDR_RANGE_OK(0x9D000u, 0xFFFFFF00u) && FL_PROTECTED(0xBB000u, 0xFFFFF000u));
+    check("app windows: FL_DATA 0x9D000-0xBAFFF, FL_OTA 0xBB000-0xBFFFF, FL_SMP 0xC2000-0xE9FFF",
+          FL_GUARD(0x9D000u, 0x1000u) && FL_GUARD(0xBA000u, 0x1000u) && FL_GUARD(0xBF000u, 0x1000u) &&
+          FL_GUARD(0xC2000u, 0x1000u) && FL_GUARD(0xE9000u, 0x1000u) && FL_GUARD(0xEA000u, 0x1000u) &&
+          !FL_GUARD(0x9C000u, 0x1000u) && allowed == (0xC0000u - 0x9D000u + 0xEB000u - 0xC2000u) / 0x1000u);
+    check("loader: app area 0x4000-0x9CFFF, records 0x9D000-0xBFFFF only",
+          LDR_RANGE_OK(0x4000u, 0x1000u) && LDR_RANGE_OK(0x9C000u, 0x1000u) && LDR_RANGE_OK(0xBF000u, 0x1000u) &&
+          !LDR_RANGE_OK(0xC0000u, 0x1000u) && FL_REC_HI == 0xC0000u);
+    for (o = 0; o < OBJ_COUNT; o++)
+        for (c = 0; c < 2u; c++)
+            in_store &= FL_STORE_OK(st_sector(o, c), 0x1000u);
+    {   /* every object's two copies distinct */
+        uint32_t o2, c2, distinct = 1;
+        for (o = 0; o < OBJ_COUNT; o++)
+            for (c = 0; c < 2u; c++)
+                for (o2 = 0; o2 < OBJ_COUNT; o2++)
+                    for (c2 = 0; c2 < 2u; c2++)
+                        if ((o != o2 || c != c2) && st_sector(o, c) == st_sector(o2, c2))
+                            distinct = 0;
+        check("storage.c: every object (A/B) in approved store, no two share a sector", in_store && distinct);
+    }
+    check("storage.c: settings 0x9D000/0x9E000, projects from 0x9F000",
+          st_sector(OBJ_SETTINGS, 0) == 0x9D000u && st_sector(OBJ_SETTINGS, 1) == 0x9E000u && st_sector(OBJ_PROJECT0, 0) == 0x9F000u);
+    check("FL_PLAIN_LO = the VM start 0x9D000", FL_PLAIN_LO == 0x9D000u);
+    check("FL_JEDEC_OK: the SMK part 0xEB6014 and 0x856014 only", FL_JEDEC_OK(0xEB6014u) && FL_JEDEC_OK(0x856014u) &&
+          !FL_JEDEC_OK(0u) && !FL_JEDEC_OK(0xFFFFFFu) && !FL_JEDEC_OK(0xEB6015u));
+    printf("%s\n", bad ? "SMK FLASH TEST FAILED" : "smk flash test passed");
+    return bad != 0;
+}
diff --git a/tests/smk_pkg_test.py b/tests/smk_pkg_test.py
new file mode 100644
index 0000000..08bb05a
--- /dev/null
+++ b/tests/smk_pkg_test.py
@@ -0,0 +1,54 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-only
+"""An SMK-37 Pro package from fm1pkg_make.py --board smk37: flash.bin is the stock PRCT size (0x9D000) and
+its app area carries the stock v016 region table exactly (see the fm1-to-smk37 guide), so the SDK
+and a later stock rollback see the same VM / BTIF / USRTRIM / USRFLASH / USR regions.
+  smk_pkg_test.py PACKAGE.fwsc [PRODUCT]"""
+import struct
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "tools"))
+import fm1_install as I  # noqa: E402
+import fm1pkg_make as M  # noqa: E402
+
+failed = 0
+
+
+def ok(cond, what):
+    global failed
+    print(f"smk pkg: {what:<70} {'ok' if cond else 'FAIL'}")
+    failed += not cond
+
+
+raw = Path(sys.argv[1]).read_bytes()
+want_product = sys.argv[2] if len(sys.argv) > 2 else "SMK-37 Pro_900"
+image, n = I.deinterleave(raw)
+ok(n == 20 and I.product_of(raw) == want_product and not I.package_damage(image),
+   f"identity {I.product_of(raw)}, 20 blocks, CRCs ok")
+hdr = I._dec(image[:0x40])
+e0 = I._dec(image[0x40:0x90])
+off, size = struct.unpack_from("<II", e0, 8)
+ok(struct.unpack_from("<H", e0, 0)[0] == 0 and size == 0x9D000, f"flash.bin {size:#x} B (stock PRCT 0x9D000)")
+flash = bytearray(image[off:off + size])
+area = bytearray(flash[0x4000:0x4000 + 0x400])
+M.sfc(area, 0, len(area), 0, M.KEY)
+ents = []
+for k in range(1, 12):
+    e = bytes(area[k * 32:(k + 1) * 32])
+    if M.crc16(e[2:]) != struct.unpack_from("<H", e)[0]:
+        break
+    dcrc, eoff, esize, flags, resvd, index = struct.unpack_from("<HIIBBH", e, 2)
+    ents.append((eoff, esize, flags, resvd, index, e[16:32]))
+want = [(0x9D000, 0x23000, 0x12, 0x81, 0, bytes.fromhex("564d00ffffffffffffffffff00800000")),
+        (0, 0x9D000, 0x92, 0x82, 0, bytes.fromhex("5052435400ffffffffffffff434f4445")),
+        (0xC0000, 0x1000, 0x92, 0x82, 0, bytes.fromhex("4254494600ffffffffffffff4155544f")),
+        (0xC1000, 0x1000, 0x92, 0x81, 0, bytes.fromhex("5553525452494d00ffffffffffffffff")),
+        (0xC2000, 0x29000, 0x92, 0x81, 0, bytes.fromhex("555352464c41534800ffffffffffffff")),
+        (0xF4000, 0xA000, 0x92, 0x81, 1, b"USR\0" + b"\xff" * 12)]
+ok([e[5][:7] for e in ents[:2]] == [b"app.bin", b"cfg_too"], "app.bin, cfg_tool.bin first")
+ok(ents[2:] == want, "region table == stock v016 (VM, PRCT, BTIF, USRTRIM, USRFLASH, USR)")
+ok(flash[:0x4000] != b"\xff" * 0x4000, "head present (never written by the loader, checked against the device)")
+print("SMK PACKAGE TEST FAILED" if failed else "smk package test passed")
+sys.exit(1 if failed else 0)
