@@ -9,11 +16,19 @@
  *   fm1_lcd_send_data(p, n)    D/C high, CS low, DMA n bytes from RAM p
  *   fm1_lcd_wait()             SPI done (or timeout, counted), pending cleared
  *   fm1_lcd_deselect()         CS high
