+static int st_owner_check(void)
+{
+    static const char FAM[] = FELUCCA_DATA_FAMILY;
+    uint8_t tag[16], want[16];
+    uint32_t i, erased = 1, ours = 1, s;
+    st_owner_ready = 0;
+    for (i = 0; i < 16u; i++)
+        want[i] = i < 9u ? (uint8_t)"SMK37DATA"[i] : i - 9u < sizeof FAM - 1u ? (uint8_t)FAM[i - 9u] : 0u;
+    if (st_read(ST_OWNER_OFF, tag, 16)) return -1;
+    for (i = 0; i < 16u; i++) {
+        erased &= tag[i] == 0xFFu;
+        ours &= tag[i] == want[i];
+    }
+    if (ours) { st_owner_ready = 1; return 0; }
+    if (!erased || !FELUCCA_DATA_UNTAGGED_OK) {
+        for (s = 0; s < OBJ_COUNT * 2u; s++) {
+            uint32_t off = st_sector(s / 2u, s % 2u);
+            int rc = st_erase(off);
+            ST_INIT_TICK();                      /* erase returned with XIP/interrupts restored */
+            if (rc || st_erased(off)) return -1;
+        }
+        st_owner_cleared = 1;
+    }
+    {
+        int rc = st_erase(ST_OWNER_OFF);
+        ST_INIT_TICK();
+        if (rc || st_erased(ST_OWNER_OFF)) return -1;
+    }
+    if (st_prog(ST_OWNER_OFF, want, sizeof want) || st_read(ST_OWNER_OFF, tag, sizeof tag)) return -1;
+    for (i = 0; i < sizeof tag; i++) if (tag[i] != want[i]) return -1;
